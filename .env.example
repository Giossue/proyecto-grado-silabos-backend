APP_NAME="Sílabos UEB"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Origen exacto del SPA que consume la API. No terminar con barra.
FRONTEND_URL=http://localhost:5173
# Host:puerto del SPA separados por coma. En producción incluye cada dominio permitido.
SANCTUM_STATEFUL_DOMAINS=localhost:5173

APP_TIMEZONE=UTC
DISPLAY_TIMEZONE=America/Guayaquil
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=silabos_ueb
DB_USERNAME=silabos_ueb
DB_PASSWORD=silabos_ueb
DB_TIMEZONE=UTC

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=private
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=180

CACHE_STORE=redis
CACHE_PREFIX=silabos-ueb

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=56379

AI_DRIVER=disabled
# Chat de unidades: openai, claude o deepseek. AI_BASE_URL admite la URL base
# o el endpoint completo; la clave permanece únicamente en el entorno de despliegue.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_CONNECT_TIMEOUT=2
AI_TIMEOUT=20
# La normalización de documentos PDF es independiente del proveedor del chat.
# Actívela solo después de configurar la clave de DeepSeek.
AI_SOURCE_NORMALIZATION_ENABLED=false
AI_SOURCE_NORMALIZATION_DRIVER=deepseek
# El modelo oficial actual de DeepSeek V4.1 Flash se identifica como deepseek-flash.
AI_SOURCE_NORMALIZATION_BASE_URL=https://api.deepseek.com
AI_SOURCE_NORMALIZATION_MODEL=deepseek-flash
AI_SOURCE_NORMALIZATION_API_KEY=
AI_SOURCE_NORMALIZATION_CONNECT_TIMEOUT=5
AI_SOURCE_NORMALIZATION_TIMEOUT=120
AI_SOURCE_NORMALIZATION_BATCH_INPUT_CHARACTERS=100000
AI_SOURCE_NORMALIZATION_MAX_OUTPUT_TOKENS=20000
# Extracción curricular de documentos PDF/XLSX (I-145).
# Genera propuestas que Coordinación confirma; no modifica datos vigentes por sí sola.
CURRICULAR_EXTRACTION_ENABLED=false
CURRICULAR_EXTRACTION_BASE_URL=https://api.deepseek.com
CURRICULAR_EXTRACTION_MODEL=deepseek-flash
CURRICULAR_EXTRACTION_API_KEY=

# Ingesta PDF estructurada. Se mantiene apagada hasta resolver PV-12/PV-14.
OPENPARSER_ENABLED=false
OPENPARSER_BASE_URL=https://api.openparser.dev
OPENPARSER_API_KEY=
OPENPARSER_OCR_MODEL=paddleocr-vl-1.6
OPENPARSER_CONNECT_TIMEOUT=5
OPENPARSER_TIMEOUT=120
OPENPARSER_POLL_DELAY=5
OPENPARSER_MAX_POLL_MINUTES=20
OPENPARSER_MAX_UPLOAD_BYTES=52428800
OPENPARSER_MAX_RESPONSE_BYTES=52428800
OPENPARSER_MAX_IMAGE_BYTES=10485760
OPENPARSER_FIGURE_RENDER_DPI=144
OPENPARSER_FIGURE_RENDER_TIMEOUT=60
OPENPARSER_ALLOWED_ASSET_HOSTS=api.openparser.dev

# `log` no envía: escribe el correo en el registro. Es el valor seguro mientras PV-15
# —correo institucional y contenido de avisos— siga abierta.
# Para enviar de verdad: MAIL_MAILER=resend y RESEND_API_KEY con la clave del panel.
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-responder@devs-ueb.tech"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
