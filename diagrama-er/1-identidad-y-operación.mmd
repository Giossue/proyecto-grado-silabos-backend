erDiagram
    usuarios {
        uuid id PK
        varchar nombre_usuario
        varchar correo_electronico
        timestamptz correo_verificado_en
        varchar contrasena
        boolean usuario_activo
        varchar codigo_recordarme
        text secreto_dos_factores
        text codigos_recuperacion_dos_factores
        timestamptz dos_factores_confirmado_en
    }
    asignaciones_rol {
        uuid id PK
        uuid usuario_id FK
        uuid carrera_id FK
        boolean asignacion_rol_activa
        timestamptz asignado_en
        varchar rol
    }
    invitaciones_activacion {
        uuid id PK
        uuid usuario_id FK
        char huella_activacion
        timestamptz expira_en
        timestamptz usada_en
        timestamptz invalidada_en
        uuid emitida_por_usuario_id FK
        timestamptz creada_en
    }
    restablecimientos_contrasena {
        varchar email
        varchar token
        timestamptz created_at
    }
    sesiones {
        varchar id PK
        uuid user_id FK
        varchar ip_address
        text user_agent
        text payload
        integer last_activity
    }
    eventos_auditoria {
        uuid id PK
        uuid actor_usuario_id FK
        uuid asignacion_rol_id FK
        varchar accion_evento_auditoria
        varchar tipo_recurso
        uuid recurso_id
        varchar resultado_evento_auditoria
        jsonb metadatos_evento_auditoria
        uuid correlacion_id
        timestamptz ocurrido_en
    }
    notificaciones_internas {
        uuid id PK
        uuid usuario_id FK
        varchar clave_deduplicacion
        varchar tipo_notificacion_interna
        varchar titulo_notificacion_interna
        text mensaje_notificacion_interna
        varchar tipo_recurso
        uuid recurso_id
        timestamptz leido_en
        timestamptz notificado_en
    }
    ejecuciones_trabajo {
        uuid id PK
        varchar tipo_ejecucion_trabajo
        varchar estado_ejecucion_trabajo
        varchar clave_idempotencia
        uuid correlacion_id
        smallint intentos
        smallint progreso
        jsonb resultado_ejecucion_trabajo
        varchar codigo_error
        text mensaje_error
        timestamptz iniciado_en
        timestamptz finalizado_en
        timestamptz encolado_en
        varchar cola
        varchar tipo_recurso
        uuid recurso_id
        smallint intentos_maximos
        jsonb entrada_ejecucion_trabajo
    }
    trabajos_fallidos {
        bigint id PK
        varchar uuid
        varchar connection
        varchar queue
        text payload
        text exception
        timestamp_without_time_zone failed_at
    }
    objetos_almacenados {
        uuid id PK
        varchar disco
        varchar ruta_interna
        varchar nombre_logico
        varchar mime
        bigint tamano_bytes
        char huella_sha256
        varchar clasificacion
        varchar estado_objeto_almacenado
        uuid propietario_usuario_id FK
        uuid carrera_id FK
        timestamptz almacenado_en
    }
    migraciones {
        integer id PK
        varchar migration
        integer batch
    }
    carreras {
        uuid id PK
    }
    carreras |o--o{ asignaciones_rol : "carrera_id"
    usuarios ||--o{ asignaciones_rol : "usuario_id"
    asignaciones_rol |o--o{ eventos_auditoria : "asignacion_rol_id"
    usuarios |o--o{ eventos_auditoria : "actor_usuario_id"
    usuarios |o--o{ invitaciones_activacion : "emitida_por_usuario_id"
    usuarios ||--o{ invitaciones_activacion : "usuario_id"
    usuarios ||--o{ notificaciones_internas : "usuario_id"
    carreras |o--o{ objetos_almacenados : "carrera_id"
    usuarios |o--o{ objetos_almacenados : "propietario_usuario_id"
    usuarios |o--o{ sesiones : "user_id"
