erDiagram
    facultades {
        uuid id PK
        varchar nombre_facultad
        boolean facultad_activa
        uuid logo_objeto_id FK
        varchar campus_facultad
    }
    carreras {
        uuid id PK
        uuid facultad_id FK
        varchar codigo_carrera
        varchar nombre_carrera
        boolean carrera_activa
        varchar modalidad_carrera
        smallint cantidad_ciclos_malla
    }
    asignaturas {
        uuid id PK
        varchar codigo_asignatura
        varchar nombre_asignatura
        smallint ciclo_asignatura
        numeric creditos_asignatura
        boolean asignatura_activa
        numeric horas_ac
        numeric horas_pae
        numeric horas_aa
        smallint orden_asignatura_en_ciclo
        varchar unidad_organizativa_curricular_asignatura
        varchar modalidad_asignatura
        uuid carrera_id FK
        smallint total_horas_asignatura
    }
    requisitos_asignatura {
        uuid id PK
        uuid asignatura_id FK
        uuid requisito_id FK
        varchar tipo_requisito_asignatura
    }
    periodos_academicos {
        uuid id PK
        varchar codigo_periodo_academico
        date fecha_inicio_periodo
        date fecha_fin_periodo
        smallint cantidad_semanas_lectivas
    }
    programaciones_asignatura {
        uuid id PK
        uuid periodo_academico_id FK
        uuid asignatura_id FK
        boolean programacion_asignatura_activa
    }
    paralelos {
        uuid id PK
        uuid programacion_asignatura_id FK
        varchar codigo_paralelo
        varchar jornada_paralelo
    }
    asignaciones_paralelo {
        uuid id PK
        uuid paralelo_id FK
        boolean asignacion_paralelo_activa
        timestamptz asignado_en
        uuid asignacion_rol_id FK
    }
    conceptos_curriculares {
        uuid id PK
        varchar clave_concepto
        varchar etiqueta_concepto
        varchar tipo_concepto
        jsonb columnas_concepto
    }
    valores_curriculares {
        uuid id PK
        uuid concepto_id FK
        uuid carrera_id
        uuid asignatura_id FK
        jsonb valor_curricular
        jsonb evidencia_curricular
        uuid confirmado_por FK
        timestamptz confirmado_en
    }
    importaciones_curriculares {
        uuid id PK
        uuid carrera_id FK
        uuid solicitado_por FK
        varchar estado_importacion
        char clave_idempotencia_importacion
        jsonb documentos_importacion
        jsonb propuesta_importacion
        jsonb seleccion_aplicada
        text instrucciones_importacion
        text mensaje_error_importacion
        timestamptz solicitado_en
        timestamptz aplicado_en
    }
    fuentes_academicas {
        uuid id PK
        uuid carrera_id FK
        varchar nombre_fuente_academica
        boolean fuente_academica_activa
        uuid objeto_pdf_id FK
        varchar estado_ingesta_fuente
        timestamptz ingesta_actualizada_en
        jsonb documento_fuente_academica
    }
    asignaciones_rol {
        uuid id PK
    }
    objetos_almacenados {
        uuid id PK
    }
    usuarios {
        uuid id PK
    }
    asignaciones_rol ||--o{ asignaciones_paralelo : "asignacion_rol_id"
    paralelos ||--o{ asignaciones_paralelo : "paralelo_id"
    carreras ||--o{ asignaturas : "carrera_id"
    facultades ||--o{ carreras : "facultad_id"
    objetos_almacenados |o--o{ facultades : "logo_objeto_id"
    objetos_almacenados |o--o{ fuentes_academicas : "objeto_pdf_id"
    carreras ||--o{ fuentes_academicas : "carrera_id"
    usuarios ||--o{ importaciones_curriculares : "solicitado_por"
    carreras ||--o{ importaciones_curriculares : "carrera_id"
    programaciones_asignatura ||--o{ paralelos : "programacion_asignatura_id"
    periodos_academicos ||--o{ programaciones_asignatura : "periodo_academico_id"
    asignaturas ||--o{ programaciones_asignatura : "asignatura_id"
    asignaturas ||--o{ requisitos_asignatura : "requisito_id"
    asignaturas ||--o{ requisitos_asignatura : "asignatura_id"
    conceptos_curriculares ||--o{ valores_curriculares : "concepto_id"
    usuarios ||--o{ valores_curriculares : "confirmado_por"
    asignaturas ||--o{ valores_curriculares : "asignatura_id"
