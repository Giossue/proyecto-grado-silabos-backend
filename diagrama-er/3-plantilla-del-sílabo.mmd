        varchar clave_campo_plantilla
        varchar titulo_campo_plantilla
        smallint posicion_campo_plantilla
        jsonb configuracion_campo_plantilla
    }
    definiciones_campo {
        uuid id PK
        uuid campo_plantilla_id FK
        varchar clave_definicion_campo
        varchar etiqueta_definicion_campo
        text ayuda_definicion_campo
