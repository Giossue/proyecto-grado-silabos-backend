erDiagram
    artefactos_exportacion {
        uuid id PK
        uuid revision_silabo_id FK
        uuid ejecucion_trabajo_id FK
        uuid objeto_docx_id FK
        uuid objeto_pdf_id FK
        varchar version_renderizador
        varchar idioma
        uuid clave_idempotencia
        varchar estado_artefacto_exportacion
        uuid solicitado_por FK
        timestamptz solicitado_en
        timestamptz completado_en
    }
    firmas_documento {
        uuid id PK
        uuid artefacto_exportacion_id FK
        varchar rol_firma
        uuid usuario_id FK
        uuid objeto_almacenado_id FK
        varchar certificado_titular
        varchar certificado_serie
        varchar certificado_emisor
        timestamptz certificado_vence_en
        char huella_sha256
        timestamptz firmado_en
    }
    ejecuciones_trabajo {
        uuid id PK
    }
    objetos_almacenados {
        uuid id PK
    }
    revisiones_silabo {
        uuid id PK
    }
    usuarios {
        uuid id PK
    }
    objetos_almacenados |o--o| artefactos_exportacion : "objeto_pdf_id"
    revisiones_silabo ||--o{ artefactos_exportacion : "revision_silabo_id"
    usuarios ||--o{ artefactos_exportacion : "solicitado_por"
    ejecuciones_trabajo |o--o| artefactos_exportacion : "ejecucion_trabajo_id"
    objetos_almacenados |o--o| artefactos_exportacion : "objeto_docx_id"
    artefactos_exportacion ||--o{ firmas_documento : "artefacto_exportacion_id"
    objetos_almacenados ||--o| firmas_documento : "objeto_almacenado_id"
    usuarios ||--o{ firmas_documento : "usuario_id"
